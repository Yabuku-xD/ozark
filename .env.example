# Ozark environment configuration.
# Copy to `.env` and adjust as needed.  All values are optional.

# HTTP port the backend listens on (default 8787).
PORT=8787

# Docker-published port (used by docker-compose; defaults to 8787).
OZARK_PORT=8787

# SSRF protection: block private/loopback endpoints by default (0).
# Set to 1 ONLY if you need to point Ozark at an internal agent.
OZARK_ALLOW_PRIVATE_ENDPOINTS=0

# Comma-separated allowlist of hostnames for live-agent endpoints.
# If set, only these hosts may be used as live endpoints.
# OZARK_ALLOWED_ENDPOINT_HOSTS=agent.internal.example.com

# Comma-separated allowlist of root directories for trace ingestion.
# Defaults to the project root if unset.
# OZARK_ALLOWED_TRACE_ROOTS=/app/examples

# Path to an agent config JSON file/directory to import on startup.
# OZARK_AGENT_PATH=/app/agents/my-agent.json

# ─── LLM Judge ────────────────────────────────────────
# Bring any OpenAI-compatible or Anthropic-compatible endpoint.
# If JUDGE_PROVIDER is unset, Ozark falls back to a deterministic offline heuristic.

# Which SDK to use: "openai" or "anthropic".
# JUDGE_PROVIDER=openai

# API key for the judge provider.
# JUDGE_API_KEY=sk-...

# Base URL (optional). Override for Azure, Ollama, vLLM, LiteLLM, Groq, Together, etc.
# OpenAI default:   https://api.openai.com/v1
# Anthropic default: https://api.anthropic.com
# Ollama example:    http://localhost:11434/v1
# JUDGE_BASE_URL=http://localhost:11434/v1

# Model name to use for judging.
# JUDGE_MODEL=gpt-4o-mini

# Context window in tokens (optional; used to truncate long text before judging).
# JUDGE_CONTEXT_WINDOW=128000
